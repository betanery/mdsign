# Copie para .env.local e preencha. Tudo que começa com VITE_ é público
# (vai para o navegador): nunca coloque chaves de API ou segredos aqui.

# URL canônica do site, sem barra final (usada em canonical, Open Graph e sitemap)
VITE_SITE_URL=

# Aplicação MDSign (Fase 2) — destino do botão "Entrar"
VITE_APP_URL=
# Cadastro no plano gratuito Cedro — destino de "Comece grátis"
VITE_SIGNUP_URL=
# Contratação dos planos pagos (Fase 3) — recebe ?plano=<id>
VITE_CHECKOUT_URL=
# Documentação da API (vazio = página /desenvolvedores)
VITE_API_DOCS_URL=

# Backend/Edge Function que recebe os leads (POST JSON). Vazio = WhatsApp.
VITE_LEAD_ENDPOINT=

# Google Tag Manager (opcional), ex.: GTM-XXXXXXX
VITE_GTM_ID=
